# Google Earth Engine Cloud Project ID
GEE_PROJECT=aces2-511018

# Google Gemini Model Name (recommended: gemini-3.5-flash or gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash

# Google Gemini API Key (keep secret, do not commit real keys)
GEMINI_API_KEY=your_gemini_api_key_here

# Allowed CORS origins for production (comma-separated, optional)
# CORS_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173
